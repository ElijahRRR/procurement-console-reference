# 采购控制台服务端配置样例。用法：cp .env.example .env，再按需修改 .env。
#
# - backend/.env 由 registry/settings.py 在进程第一次读设置时加载；已经存在的进程环境变量优先，不会被覆盖。
# - 格式：每行一个 KEY=VALUE（可加 export 前缀），# 开头的行是注释。不带引号的值里「空白 + #」之后是行尾注释
#   （# 前面没有空白时算值的一部分）；值本身含「 #」（如数据库密码）时用成对的单 / 双引号括起，引号里原样保留，
#   收尾引号之后可以再跟「# 注释」。
# - 下面除飞书凭证外都写成注释，括号里是缺省值。要改哪一项，去掉行首的 # 再改值；
#   值留空（KEY=）等于没写，用缺省值。
# - backend/.env 已在 .gitignore 里。真实的 App Secret、表格链接与 token 只写进 .env，不要写进本文件。

# ── 数据库 ────────────────────────────────────────────────────────────────────

# PostgreSQL 连接串（libpq 格式或 postgresql:// 网址）。缺省 dbname=procurement：本机套接字、当前系统用户。
# 库不存在时 python cli.py db_init 会连同一服务器的 postgres 库把它建出来。
# PC_PG_DSN=dbname=procurement
# PC_PG_DSN=host=127.0.0.1 port=5432 dbname=procurement user=procurement password=

# ── HTTP 服务 ─────────────────────────────────────────────────────────────────

# 监听地址（缺省 127.0.0.1，只在本机可访问）。改成别的地址时，用来访问的主机名还要写进 PC_ALLOWED_HOSTS。
# PC_HOST=127.0.0.1
# 监听端口（缺省 8790）。插件设置页里的服务端地址要跟着改。
# PC_PORT=8790
# 除 127.0.0.1、localhost 和 PC_HOST 之外还接受的 Host 主机名，逗号分隔（缺省为空）。防 DNS 重绑定用。
# PC_ALLOWED_HOSTS=
# 控制台构建产物目录（缺省 <仓库>/web/dist）。目录里没有 index.html 时，访问 / 只显示一行提示。
# PC_WEB_DIST=/path/to/web/dist

# ── 登录与安全 ────────────────────────────────────────────────────────────────

# 登录会话有效天数（缺省 14）
# PC_SESSION_DAYS=14
# 会话 Cookie 是否带 Secure、只走 HTTPS（缺省 0）。只有经 HTTPS 访问控制台时才设为 1；本机 http:// 访问保持 0。
# PC_COOKIE_SECURE=0
# 限速窗口内，同一来源地址 + 用户名登录失败多少次后返回 429（缺省 10）
# PC_LOGIN_FAIL_LIMIT=10
# 限速窗口内，同一来源地址插件配对失败多少次后返回 429（缺省 20）
# PC_PAIR_FAIL_LIMIT=20
# 失败限速的统计窗口，秒（缺省 600）
# PC_RATE_WINDOW_S=600

# ── 插件与执行 ────────────────────────────────────────────────────────────────

# 配对码有效期，秒（缺省 600，即 10 分钟）
# PC_PAIRING_TTL_S=600
# 执行批次租约有效期，秒（缺省 180）。插件按它定续租节奏，过期的批次由清扫收回。
# PC_LEASE_TTL_S=180
# 身份要在多少秒内上报过，才允许开始批次、领取和提交登记（缺省 600）
# PC_IDENTITY_FRESH_S=600
# 候选任务暂时被别的事务锁住时，告诉插件隔多少秒再领（缺省 5）
# PC_CLAIM_BUSY_RETRY_S=5

# ── 后台调度（python cli.py serve 内） ────────────────────────────────────────

# 租约清扫间隔，秒（缺省 30）
# PC_SWEEP_INTERVAL_S=30
# 多久检查一次有没有到期要读的飞书连接，秒（缺省 30；每个连接自己的读取间隔在控制台里设）
# PC_INTAKE_CHECK_S=30
# 飞书写回队列的发送间隔，秒（缺省 60）
# PC_WRITEBACK_INTERVAL_S=60

# ── 飞书自建应用（不用飞书、只用文件导入时留空即可） ──────────────────────────

# 飞书开放平台自建应用的 App ID 与 App Secret（缺省为空 = 未配置；控制台显示「未配置飞书应用」，文件导入不受影响）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 飞书开放平台接口地址（缺省 https://open.feishu.cn）
# FEISHU_BASE_URL=https://open.feishu.cn

# ── 只给后端测试用（写在 .env 里无效） ────────────────────────────────────────

# 后端测试不读 backend/.env，也会清掉进程环境里的 PC_* / FEISHU_*（测试只认缺省设置）。
# 唯一读取的是 pytest 建临时库用的管理连接（缺省 dbname=postgres），必须放在进程环境里：
#   PC_TEST_ADMIN_DSN="host=127.0.0.1 dbname=postgres" python -m pytest -q
