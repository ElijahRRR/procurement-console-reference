{
  "name": "procurement-console-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "采购控制台前端（Vue 3 + Element Plus + Tailwind 3，EasyQuick 外观）",
  "scripts": {
    "tokens": "node scripts/gen-design-tokens.mjs",
    "predev": "node scripts/gen-design-tokens.mjs",
    "dev": "vite",
    "prebuild": "node scripts/gen-design-tokens.mjs",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "pretest": "node scripts/gen-design-tokens.mjs",
    "test": "vitest run",
    "preview": "vite preview",
    "shots": "node tests/visual/screenshots.ts"
  },
  "dependencies": {
    "element-plus": "2.14.7",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.4.6",
    "autoprefixer": "10.6.1",
    "jsdom": "29.1.1",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.13"
  },
  "engines": {
    "node": ">=20.19"
  }
}
